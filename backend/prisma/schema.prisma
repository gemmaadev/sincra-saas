generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum TagPriority {
  LOW
  MEDIUM
  HIGH
}

enum ClientStage {
  LEAD // initial contact, no purchase
  NEW // first recent purchase
  RECURRING // multiple purchases
  INACTIVE // stopped buying
}

enum Channel {
  GMAIL
  OUTLOOK
  WHATSAPP
  INSTAGRAM
  MESSENGER
}

model Business {
  id          String   @id @default(uuid())
  name        String
  sector      String?
  description String?
  country     String   @default("ES")
  phone       String?
  address     String?
  schedule    String?
  nif         String?
  email       String?
  stripeId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  memberships BusinessMember[]
  clients     Client[]
  tags        Tag[]
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  passwordHash      String?
  googleId          String?  @unique
  microsoftId       String?  @unique
  invitationCode    String?
  notificationPrefs Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships         BusinessMember[]
  passwordResetTokens PasswordResetToken[]
}

model BusinessMember {
  id            String     @id @default(uuid())
  businessId    String
  userId        String
  role          Role       @default(EMPLOYEE)
  status        UserStatus @default(PENDING)
  avatarUrl     String?
  phone         String?
  businessEmail String?
  createdAt     DateTime   @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Client {
  id          String       @id @default(uuid())
  businessId  String
  name        String
  email       String?
  phone       String?
  channels    Channel[]
  type        String?
  stage       ClientStage?
  address     String?
  zone        String?
  latitude    Float?
  longitude   Float?
  lastContact DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientTags ClientTag[]
  notes      Note[]

  @@unique([businessId, email])
  @@unique([businessId, phone])
  @@index([businessId])
  @@index([businessId, stage])
  @@index([name])
}

model Note {
  id        String   @id @default(uuid())
  clientId  String
  content   String
  createdBy String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Tag {
  id          String      @id @default(uuid())
  businessId  String
  name        String
  color       String
  priority    TagPriority @default(LOW)
  isDefault   Boolean     @default(false)
  aiGenerated Boolean     @default(false)
  createdBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientTags ClientTag[]

  @@unique([businessId, name])
  @@index([businessId])
}

model ClientTag {
  id          String    @id @default(uuid())
  clientId    String
  tagId       String
  aiGenerated Boolean   @default(false)
  createdAt   DateTime  @default(now())
  removedAt   DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([tagId])
}
